# ~/.config/kitty/kitty.conf - Versão Estável e Limpa

enable_gpu_rendering no
background_opacity 1.0 
# background #1A1A2E 
# foreground #D9E0EE 
# color0 #1A1A2E 
# color1 #FF4500 
# color2 #39FF14 
# color3 #FFD700
# color4 #8B008B 
# color5 #FF007F
# color6 #00FFFF 
# color7 #D9E0EE
# font_family Mononoki
symbol_map U+E000-U+FFFF AnonymicePro Nerd Font Regular
font_size 15.0


# BEGIN_KITTY_THEME
# Gruvbox Dark
include current-theme.conf
# END_KITTY_THEME

# BEGIN_KITTY_FONTS
font_family      family="UbuntuMono Nerd Font"
bold_font        auto
italic_font      auto
bold_italic_font auto
# END_KITTY_FONTS
